# Supabase connection (required)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Server-only service role key (required for webhooks and atomic payment confirmation)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App deployment mode (optional: "storefront", "admin", or unset for both)
# NEXT_PUBLIC_APP_MODE=

# Storefront Public URL (used for Bachs success_url and cancel_url redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bachs.io Payment Gateway Configuration
# Obtain credentials from: https://dashboard.bachs.io or https://sandbox.bachs.io
# Sandbox secret keys start with sk_sandbox_..., Live keys start with sk_live_...
BACHS_SECRET_KEY=sk_sandbox_your_bachs_secret_key
# Webhook signing secret configured in Bachs dashboard under Webhook Endpoints
BACHS_WEBHOOK_SECRET=whsec_your_bachs_webhook_signing_secret
# Environment: "sandbox" or "production" (optional - auto-detected from key prefix if omitted)
BACHS_ENVIRONMENT=sandbox

# Cloudinary image storage credentials (optional - for admin product image upload)
# Obtain from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
